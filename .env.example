# Nebius Token Factory (OpenAI-compatible). Create a key in the Token Factory console.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Any NVIDIA open model from the Token Factory catalog. Check the catalog for the exact id.
NEMOTRON_MODEL=nvidia/Nemotron-3-Nano-30B-A3B
# Optional: a bigger Nemotron (Super/Ultra) for verdicts the small model is unsure about. Empty = off.
NEMOTRON_ESCALATE_MODEL=
HALFLIFE_ESCALATE_BELOW=0.6

# Tavily
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

# Pipeline
HALFLIFE_CONCURRENCY=32
HALFLIFE_MAX_CLAIMS=200
HALFLIFE_CACHE_DIR=.halflife-cache

# Hosted demo only: cap claims per run and live runs per hour so judges can't drain the credits.
HALFLIFE_PUBLIC_DEMO=0
HALFLIFE_DEMO_MAX_CLAIMS=40
HALFLIFE_DEMO_RUNS_PER_HOUR=20
